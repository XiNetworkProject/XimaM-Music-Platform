# PostgreSQL local. Garder cette URL exclusivement cote serveur.
DATABASE_URL=postgresql://synaura:mot_de_passe@127.0.0.1:5433/postgres
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_SSL=false

# Sessions web et mobile.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=remplacer_par_un_secret_long_et_aleatoire
# Origines web supplementaires autorisees pour les mutations custom (CSV).
ALLOWED_WEB_ORIGINS=

# Destinataires autorises pour l'email statique de presentation Alertemps.
# Sans valeur, la route cible uniquement l'adresse de session de l'admin autorise.
METEO_PRESENTATION_RECIPIENTS=

# OAuth Google reste pris en charge par NextAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret distinct envoye sous forme de jeton HMAC aux callbacks Suno.
SUNO_WEBHOOK_SECRET=remplacer_par_un_secret_long_et_aleatoire
