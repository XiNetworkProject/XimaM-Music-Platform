# Copier hors du depot vers /etc/synaura/backup.env (root:root, 0600).
# Les destinations DOIVENT etre sur un autre systeme de fichiers ou, mieux,
# repliquees hors de la Freebox.

SYNAURA_PG_SERVICE=synaura_backup
PGSERVICEFILE=/etc/synaura/pg_service.conf
SYNAURA_PG_OS_USER=postgres
SYNAURA_PG_BIN_DIR=/usr/lib/postgresql/17/bin
SYNAURA_POSTGRES_DATA=/var/lib/postgresql/17/restore
SYNAURA_DB_BACKUP_ROOT=/mnt/Synaura-SSD/apps/synaura/backups/postgres
SYNAURA_DB_BACKUP_KEY=/etc/synaura/backup-encryption.key
SYNAURA_DB_RETENTION_DAYS=14

SYNAURA_MEDIA_ROOT=/mnt/Synaura-SSD/apps/synaura/media
SYNAURA_MEDIA_MOUNT=/mnt/Synaura-SSD
SYNAURA_MEDIA_EXPECTED_SOURCE=//mafreebox.freebox.fr/Synaura SSD
SYNAURA_MEDIA_MARKER=/mnt/Synaura-SSD/.synaura-volume.id
SYNAURA_MEDIA_EXPECTED_MARKER=/etc/synaura/media-volume.id
SYNAURA_MEDIA_BACKUP_ROOT=/var/backups/synaura/media
SYNAURA_MEDIA_RETENTION_DAYS=14

# Garde-fou. Conserver 0 en production.
SYNAURA_ALLOW_SAME_DEVICE_BACKUP=0
