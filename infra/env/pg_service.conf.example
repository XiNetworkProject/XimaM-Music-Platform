# Copier dans un emplacement hors Git lisible seulement par le compte de backup.
# Le mot de passe doit etre fourni par un fichier pgpass 0600, jamais ici.

[synaura_backup]
host=/var/run/postgresql
port=5433
dbname=postgres
user=postgres
connect_timeout=10

[synaura_restore]
host=/var/run/postgresql
port=5433
dbname=postgres
user=postgres
connect_timeout=10
