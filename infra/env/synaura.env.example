# Copier hors du depot vers /etc/synaura/synaura.env (root:synaura, 0640).
# Valeurs factices uniquement. Ne jamais committer le fichier reel.

NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000

NEXTAUTH_URL=https://synaura.fr
NEXT_PUBLIC_SITE_URL=https://synaura.fr
ALLOWED_WEB_ORIGINS=https://synaura.fr,https://www.synaura.fr

DATABASE_URL=postgresql://synaura_app@127.0.0.1:5433/postgres
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=35000
DATABASE_SSL=false

SYNAURA_MEDIA_ROOT=/mnt/Synaura-SSD/apps/synaura/media
SYNAURA_MEDIA_MOUNT=/mnt/Synaura-SSD
SYNAURA_MEDIA_EXPECTED_SOURCE=//mafreebox.freebox.fr/Synaura SSD
SYNAURA_MEDIA_MARKER=/mnt/Synaura-SSD/.synaura-volume.id
SYNAURA_MEDIA_EXPECTED_MARKER=/etc/synaura/media-volume.id
SYNAURA_POSTGRES_PORT=5433
MEDIA_BASE_URL=https://media.synaura.fr
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.synaura.fr
MEDIA_STORAGE_SECRET=REPLACE_OUTSIDE_GIT

NEXTAUTH_SECRET=REPLACE_OUTSIDE_GIT
GOOGLE_CLIENT_ID=REPLACE_OUTSIDE_GIT
GOOGLE_CLIENT_SECRET=REPLACE_OUTSIDE_GIT
SUNO_API_KEY=REPLACE_OUTSIDE_GIT
SUNO_WEBHOOK_SECRET=REPLACE_OUTSIDE_GIT
STRIPE_SECRET_KEY=REPLACE_OUTSIDE_GIT
STRIPE_WEBHOOK_SECRET=REPLACE_OUTSIDE_GIT
