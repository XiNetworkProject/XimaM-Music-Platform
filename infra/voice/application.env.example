# Template only. Do not paste real credentials into this repository.
SYNAURA_CALLS_ENABLED=false
SYNAURA_CALLS_ACCESS=private
# Two to eight explicitly approved immutable profile UUIDs, comma-separated.
# Empty/malformed list disables private calls; never use usernames or wildcards.
SYNAURA_CALLS_TEST_USER_IDS=
# Must be unique for this single-process deployment; public/preview are isolated.
SYNAURA_CALLS_INSTANCE=private-preview
SYNAURA_CALLS_SINGLE_PROCESS=false
LIVEKIT_ROOM_AUTO_CREATE_DISABLED=false
LIVEKIT_URL=wss://voice.example.invalid
LIVEKIT_SERVER_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SYNAURA_CALLS_MAX_PARTICIPANTS=8
SYNAURA_CALLS_MAX_CONCURRENT=4
